      "label": "Base terrain (APRL)",
      "params": {
        "character": {
          "String": "rugged"
        },
        "frequency": {
          "Float": 3.0
        },
        "octaves": {
          "UInt": 7
        },
        "seed": {
          "UInt": 1337
        }
      }
    },
    {
