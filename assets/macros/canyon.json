{
  "name": "Canyon",
  "description": "High plateau cut by deep canyons. Inverted ridged noise carves valleys into the terrain. An adaptive blur driven by inverted slope keeps canyon walls sharp while smoothing the flat plateau tops.",
  "nodes": [
    {
      "key": "ridges",
      "type": "RidgedNoise",
      "label": "Canyon Ridges",
      "params": {
        "character": { "String": "ridges" },
        "frequency": { "Float": 2.0 },
        "octaves": { "UInt": 5 },
        "lacunarity": { "Float": 2.2 },
        "persistence": { "Float": 0.5 },
        "seed": { "UInt": 41 }
      }
    },
    {
      "key": "invert_terrain",
      "type": "Invert",
      "label": "Plateau / Canyon",
      "params": {}
    },
    {
      "key": "lift",
      "type": "BiasGain",
      "label": "Lift Plateau",
      "params": {
        "bias": { "Float": 0.65 },
        "gain": { "Float": 0.5 }
      }
    },
    {
      "key": "pre_slope",
      "type": "SlopeMap",
      "label": "Wall Steepness",
      "params": {}
    },
    {
      "key": "inv_slope",
      "type": "Invert",
      "label": "Invert Slope",
      "params": {}
    },
    {
      "key": "smooth",
      "type": "Blur",
      "label": "Adaptive Soften",
      "params": { "radius": { "Float": 1.0 } }
    },
    {
      "key": "slope_map",
      "type": "SlopeMap",
      "label": "Slope Map",
      "params": {}
    },
    {
      "key": "auto_tex",
      "type": "AutoTexture",
      "label": "Auto Texture",
      "params": { "biome": { "String": "desert" } }
    }
  ],
  "connections": [
    { "from": "ridges.output",        "to": "invert_terrain.input" },
    { "from": "invert_terrain.output","to": "lift.input" },
    { "from": "lift.output",          "to": "pre_slope.input" },
    { "from": "pre_slope.output",     "to": "inv_slope.input" },
    { "from": "inv_slope.output",     "to": "smooth.control" },
    { "from": "lift.output",          "to": "smooth.input" },
    { "from": "smooth.output",        "to": "slope_map.input" },
    { "from": "smooth.output",        "to": "auto_tex.input" },
    { "from": "slope_map.output",     "to": "auto_tex.slope" }
  ],
  "subgraph": {
    "label": "Canyon",
    "color_idx": 4,
    "collapsed": true,
    "inputs": [],
    "outputs": [
      { "name": "terrain", "label": "Terrain", "kind": "Heightmap", "binding": "smooth:output" },
      { "name": "texture", "label": "Texture", "kind": "Color",     "binding": "auto_tex:output" },
      { "name": "slope",   "label": "Slope",   "kind": "Heightmap", "binding": "slope_map:output" }
    ]
  },
  "macro_params": [
    { "name": "canyon_density",  "label": "Canyon density",  "kind": "Float", "binding": "ridges:frequency", "min": 1.0, "max": 5.0 },
    { "name": "plateau_height",  "label": "Plateau height",  "kind": "Float", "binding": "lift:bias",        "min": 0.4, "max": 0.9 },
    { "name": "wall_softness",   "label": "Wall softness",   "kind": "Float", "binding": "smooth:radius",    "min": 0.0, "max": 3.0 },
    { "name": "seed",            "label": "Seed",            "kind": "UInt",  "binding": "ridges:seed" }
  ]
}
