{
  "name": "mountain",
  "description": "Eroded mountain massif: a radial envelope shapes jagged ridged noise, thermal erosion cuts talus slopes. Additive: blend onto base with mode add, using the mask.",
  "nodes": [
    {
      "key": "env", "type": "Layout", "label": "Massif envelope",
      "params": { "item_count": { "UInt": 1 }, "mode": { "String": "ridge" }, "type_0": { "String": "ellipse" },
        "x_0": { "Float": 0.5 }, "y_0": { "Float": 0.5 }, "rx_0": { "Float": 0.32 }, "ry_0": { "Float": 0.28 },
        "angle_0": { "Float": 25.0 }, "height_0": { "Float": 1.0 }, "falloff_0": { "Float": 0.7 } }
    },
    {
      "key": "peaks", "type": "RidgedNoise", "label": "Peaks",
      "params": { "character": { "String": "jagged_peaks" }, "frequency": { "Float": 4.0 },
        "octaves": { "UInt": 6 }, "persistence": { "Float": 0.55 }, "seed": { "UInt": 5 } }
    },
    { "key": "shaped", "type": "Blend", "label": "Shaped peaks", "params": { "mode": { "String": "multiply" }, "factor": { "Float": 1.0 } } },
    { "key": "terrain", "type": "ThermalErosion", "label": "Talus erosion", "params": { "iterations": { "UInt": 100 }, "talus_angle": { "Float": 0.45 } } },
    {
      "key": "footprint", "type": "Layout", "label": "Mask",
      "params": { "item_count": { "UInt": 1 }, "mode": { "String": "mask" }, "type_0": { "String": "ellipse" },
        "x_0": { "Float": 0.5 }, "y_0": { "Float": 0.5 }, "rx_0": { "Float": 0.34 }, "ry_0": { "Float": 0.3 },
        "angle_0": { "Float": 25.0 }, "height_0": { "Float": 1.0 }, "falloff_0": { "Float": 0.6 } }
    }
  ],
  "connections": [
    { "from": "env.output", "to": "shaped.a" },
    { "from": "peaks.output", "to": "shaped.b" },
    { "from": "shaped.output", "to": "terrain.input" }
  ],
  "subgraph": {
    "outputs": [
      { "name": "terrain", "label": "Terrain", "kind": "Heightmap", "binding": "terrain:output" },
      { "name": "mask", "label": "Mask", "kind": "Mask", "binding": "footprint:output" }
    ]
  }
}
