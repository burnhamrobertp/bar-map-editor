{
  "name": "expansion-plateau",
  "description": "A small defensible flat shelf with a ramp approach (a contestable expansion site). Additive: blend onto base with mode add, using the mask.",
  "nodes": [
    {
      "key": "shelf", "type": "Layout", "label": "Shelf + ramp",
      "params": { "item_count": { "UInt": 2 }, "mode": { "String": "ridge" },
        "type_0": { "String": "ellipse" }, "x_0": { "Float": 0.5 }, "y_0": { "Float": 0.42 }, "rx_0": { "Float": 0.2 }, "ry_0": { "Float": 0.17 }, "height_0": { "Float": 1.0 }, "falloff_0": { "Float": 0.12 },
        "type_1": { "String": "rectangle" }, "x_1": { "Float": 0.5 }, "y_1": { "Float": 0.72 }, "rx_1": { "Float": 0.07 }, "ry_1": { "Float": 0.16 }, "height_1": { "Float": 0.55 }, "falloff_1": { "Float": 0.3 } }
    },
    { "key": "place", "type": "Transform", "label": "Placement", "params": { "translate_x": { "Float": 0.0 }, "translate_y": { "Float": 0.0 }, "scale": { "Float": 1.0 }, "angle": { "Float": 0.0 } } },
    { "key": "mask", "type": "MaskThreshold", "label": "Footprint", "params": { "threshold": { "Float": 0.04 }, "smoothness": { "Float": 0.1 } } }
  ],
  "connections": [
    { "from": "shelf.output", "to": "place.input" },
    { "from": "place.output", "to": "mask.input" }
  ],
  "subgraph": {
    "outputs": [
      { "name": "terrain", "label": "Terrain", "kind": "Heightmap", "binding": "place:output" },
      { "name": "mask", "label": "Mask", "kind": "Mask", "binding": "mask:output" }
    ]
  },
  "macro_params": [
    { "name": "pos_x", "label": "Position X", "kind": "Float", "binding": "place:translate_x", "min": -0.5, "max": 0.5 },
    { "name": "pos_y", "label": "Position Y", "kind": "Float", "binding": "place:translate_y", "min": -0.5, "max": 0.5 },
    { "name": "rotation", "label": "Rotation", "kind": "Float", "binding": "place:angle", "min": 0.0, "max": 360.0 },
    { "name": "size", "label": "Size", "kind": "Float", "binding": "place:scale", "min": 0.5, "max": 2.0 },
    { "name": "shelf_height", "label": "Shelf height", "kind": "Float", "binding": "shelf:height_0", "min": 0.4, "max": 1.0 }
  ]
}
