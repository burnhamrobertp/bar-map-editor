          "Float": 2.5
        },
        "octaves": {
          "UInt": 6
        },
        "lacunarity": {
          "Float": 2.2
        },
        "seed": {
          "UInt": 53
        }
      }
    },
    {
      "key": "erosion",
      "type": "ThermalErosion",
      "label": "Talus Erosion",
      "params": {
        "iterations": {
          "UInt": 120
