{
  "name": "archipelago",
  "description": "A cluster of small islands in open water. Absolute: combine with MaskApply onto a sea base (base into background, this into input, mask into mask).",
  "nodes": [
    {
      "key": "cluster", "type": "Layout", "label": "Islands",
      "params": { "item_count": { "UInt": 4 }, "mode": { "String": "ridge" },
        "type_0": { "String": "ellipse" }, "x_0": { "Float": 0.3 }, "y_0": { "Float": 0.32 }, "rx_0": { "Float": 0.12 }, "ry_0": { "Float": 0.1 }, "height_0": { "Float": 1.0 }, "falloff_0": { "Float": 0.65 },
        "type_1": { "String": "ellipse" }, "x_1": { "Float": 0.62 }, "y_1": { "Float": 0.4 }, "rx_1": { "Float": 0.09 }, "ry_1": { "Float": 0.1 }, "height_1": { "Float": 0.9 }, "falloff_1": { "Float": 0.65 },
        "type_2": { "String": "ellipse" }, "x_2": { "Float": 0.42 }, "y_2": { "Float": 0.6 }, "rx_2": { "Float": 0.11 }, "ry_2": { "Float": 0.12 }, "height_2": { "Float": 1.0 }, "falloff_2": { "Float": 0.65 },
        "type_3": { "String": "ellipse" }, "x_3": { "Float": 0.72 }, "y_3": { "Float": 0.68 }, "rx_3": { "Float": 0.08 }, "ry_3": { "Float": 0.09 }, "height_3": { "Float": 0.85 }, "falloff_3": { "Float": 0.65 },
        "type_4": { "String": "ellipse" }, "x_4": { "Float": 0.25 }, "y_4": { "Float": 0.66 }, "rx_4": { "Float": 0.07 }, "ry_4": { "Float": 0.08 }, "height_4": { "Float": 0.8 }, "falloff_4": { "Float": 0.65 },
        "type_5": { "String": "ellipse" }, "x_5": { "Float": 0.58 }, "y_5": { "Float": 0.24 }, "rx_5": { "Float": 0.08 }, "ry_5": { "Float": 0.07 }, "height_5": { "Float": 0.85 }, "falloff_5": { "Float": 0.65 } }
    },
    { "key": "place", "type": "Transform", "label": "Placement", "params": { "translate_x": { "Float": 0.0 }, "translate_y": { "Float": 0.0 }, "scale": { "Float": 1.0 }, "angle": { "Float": 0.0 } } },
    { "key": "hconst", "type": "Constant", "label": "Land height", "params": { "value": { "Float": 0.55 } } },
    { "key": "terrain", "type": "Multiply", "label": "Islands" },
    { "key": "mask", "type": "MaskThreshold", "label": "Footprint", "params": { "threshold": { "Float": 0.03 }, "smoothness": { "Float": 0.1 } } }
  ],
  "connections": [
    { "from": "cluster.output", "to": "place.input" },
    { "from": "place.output", "to": "terrain.a" },
    { "from": "hconst.output", "to": "terrain.b" },
    { "from": "place.output", "to": "mask.input" }
  ],
  "subgraph": {
    "outputs": [
      { "name": "terrain", "label": "Terrain", "kind": "Heightmap", "binding": "terrain:output" },
      { "name": "mask", "label": "Mask", "kind": "Mask", "binding": "mask:output" }
    ]
  },
  "macro_params": [
    { "name": "pos_x", "label": "Position X", "kind": "Float", "binding": "place:translate_x", "min": -0.5, "max": 0.5 },
    { "name": "pos_y", "label": "Position Y", "kind": "Float", "binding": "place:translate_y", "min": -0.5, "max": 0.5 },
    { "name": "spread", "label": "Spread", "kind": "Float", "binding": "place:scale", "min": 0.5, "max": 1.8 },
    { "name": "height", "label": "Height", "kind": "Float", "binding": "hconst:value", "min": 0.3, "max": 0.8 },
    { "name": "count", "label": "Island count", "kind": "UInt", "binding": "cluster:item_count", "min": 2, "max": 6 }
  ]
}
