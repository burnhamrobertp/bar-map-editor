{
  "name": "Archipelago",
  "description": "Scattered islands above a sea floor. A radial gradient as noise control concentrates island mass toward the center, leaving open water around the perimeter for naval approach routes.",
  "nodes": [
    {
      "key": "shape",
      "type": "Gradient",
      "label": "Island Envelope",
      "params": {
        "direction": { "String": "radial" },
        "invert": { "Bool": false },
        "center_x": { "Float": 0.5 },
        "center_y": { "Float": 0.5 }
      }
    },
    {
      "key": "noise",
      "type": "PerlinNoise",
      "label": "Island Noise",
      "params": {
        "character": { "String": "rolling_hills" },
        "frequency": { "Float": 3.0 },
        "octaves": { "UInt": 5 },
        "lacunarity": { "Float": 2.0 },
        "persistence": { "Float": 0.5 },
        "seed": { "UInt": 13 }
      }
    },
    {
      "key": "sink",
      "type": "BiasGain",
      "label": "Sink Below Sea",
      "params": {
        "bias": { "Float": 0.28 },
        "gain": { "Float": 0.5 }
      }
    },
    {
      "key": "smooth",
      "type": "Blur",
      "label": "Soften Coastlines",
      "params": { "radius": { "Float": 1.5 } }
    },
    {
      "key": "slope_map",
      "type": "SlopeMap",
      "label": "Slope Map",
      "params": {}
    },
    {
      "key": "auto_tex",
      "type": "AutoTexture",
      "label": "Auto Texture",
      "params": { "biome": { "String": "tropical" } }
    }
  ],
  "connections": [
    { "from": "shape.output",  "to": "noise.control" },
    { "from": "noise.output",  "to": "sink.input" },
    { "from": "sink.output",   "to": "smooth.input" },
    { "from": "smooth.output", "to": "slope_map.input" },
    { "from": "smooth.output", "to": "auto_tex.input" },
    { "from": "slope_map.output", "to": "auto_tex.slope" }
  ],
  "subgraph": {
    "label": "Archipelago",
    "color_idx": 3,
    "collapsed": true,
    "inputs": [],
    "outputs": [
      { "name": "terrain", "label": "Terrain", "kind": "Heightmap", "binding": "smooth:output" },
      { "name": "texture", "label": "Texture", "kind": "Color",     "binding": "auto_tex:output" },
      { "name": "slope",   "label": "Slope",   "kind": "Heightmap", "binding": "slope_map:output" }
    ]
  },
  "macro_params": [
    { "name": "island_size",      "label": "Island size",      "kind": "Float", "binding": "noise:frequency", "min": 1.0, "max": 6.0   },
    { "name": "sea_level",        "label": "Sea level",        "kind": "Float", "binding": "sink:bias",       "min": 0.1, "max": 0.5   },
    { "name": "coast_smoothness", "label": "Coast smoothness", "kind": "Float", "binding": "smooth:radius",   "min": 0.0, "max": 4.0   },
    { "name": "seed",             "label": "Seed",             "kind": "UInt",  "binding": "noise:seed" }
  ]
}
