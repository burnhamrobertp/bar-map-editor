{
  "name": "Archipelago",
  "description": "Scattered islands separated by water. Perlin noise with a downward bias so most of the map sits below sea level — only the highest peaks emerge as islands. Wire its `terrain` output to a Bundler with a min_height < 0 to render water.",
  "nodes": [
    {
      "key": "noise",
      "type": "PerlinNoise",
      "label": "Island Noise",
      "params": {
        "character": {
          "String": "rolling_hills"
        },
        "frequency": {
          "Float": 3
        },
        "octaves": {
          "UInt": 5
        },
        "lacunarity": {
          "Float": 2
        },
        "persistence": {
          "Float": 0.5
        },
        "seed": {
          "UInt": 13
        }
      }
    },
    {
      "key": "sink",
      "type": "BiasGain",
      "label": "Sink Below Sea",
      "params": {
        "bias": {
          "Float": 0.25
        },
        "gain": {
          "Float": 0.5
        }
      }
    },
    {
      "key": "smooth",
      "type": "Blur",
      "label": "Soften Coastlines",
      "params": {
        "radius": {
          "Float": 1.5
        }
      }
    },
    {
      "key": "slope_map",
      "type": "SlopeMap",
      "label": "Slope Map",
      "params": {}
    },
    {
      "key": "auto_tex",
      "type": "AutoTexture",
      "label": "Auto Texture",
      "params": {
        "biome": {
          "String": "tropical"
        }
      }
    }
  ],
  "connections": [
    {
      "from": "noise.output",
      "to": "sink.input"
    },
    {
      "from": "sink.output",
      "to": "smooth.input"
    },
    {
      "from": "smooth.output",
      "to": "slope_map.input"
    },
    {
      "from": "smooth.output",
      "to": "auto_tex.input"
    },
    {
      "from": "slope_map.output",
      "to": "auto_tex.slope"
    }
  ],
  "subgraph": {
    "label": "Archipelago",
    "color_idx": 3,
    "collapsed": true,
    "inputs": [],
    "outputs": [
      {
        "name": "terrain",
        "label": "Terrain",
        "kind": "Heightmap",
        "binding": "smooth:output"
      },
      {
        "name": "texture",
        "label": "Texture",
        "kind": "Color",
        "binding": "auto_tex:output"
      },
      {
        "name": "slope",
        "label": "Slope",
        "kind": "Heightmap",
        "binding": "slope_map:output"
      }
    ]
  },
  "macro_params": [
    {
      "name": "island_size",
      "label": "Island size",
      "kind": "Float",
      "binding": "noise:frequency",
      "min": 1,
      "max": 6
    },
    {
      "name": "sea_level",
      "label": "Sea level",
      "kind": "Float",
      "binding": "sink:bias",
      "min": 0.1,
      "max": 0.5
    },
    {
      "name": "coast_smoothness",
      "label": "Coast smoothness",
      "kind": "Float",
      "binding": "smooth:radius",
      "min": 0,
      "max": 4
    },
    {
      "name": "seed",
      "label": "Seed",
      "kind": "UInt",
      "binding": "noise:seed",
      "min": 0,
      "max": 100000
    }
  ]
}
