{
  "name": "Archipelago - Dense",
  "description": "Many small islands clustered together. Higher-frequency noise with radial shaping produces more peaks above sea level; less aggressive sinking keeps a larger fraction of the map as land.",
  "nodes": [
    {
      "key": "shape",
      "type": "Gradient",
      "label": "Island Envelope",
      "params": {
        "direction": { "String": "radial" },
        "invert": { "Bool": false },
        "center_x": { "Float": 0.5 },
        "center_y": { "Float": 0.5 }
      }
    },
    {
      "key": "noise",
      "type": "PerlinNoise",
      "label": "Island Noise",
      "params": {
        "character": { "String": "fine_detail" },
        "frequency": { "Float": 6.0 },
        "octaves": { "UInt": 6 },
        "lacunarity": { "Float": 2.0 },
        "persistence": { "Float": 0.5 },
        "seed": { "UInt": 19 }
      }
    },
    {
      "key": "sink",
      "type": "BiasGain",
      "label": "Sink Below Sea",
      "params": {
        "bias": { "Float": 0.35 },
        "gain": { "Float": 0.5 }
      }
    },
    {
      "key": "smooth",
      "type": "Blur",
      "label": "Soften Coastlines",
      "params": { "radius": { "Float": 0.8 } }
    },
    {
      "key": "slope_map",
      "type": "SlopeMap",
      "label": "Slope Map",
      "params": {}
    },
    {
      "key": "rock_soil",
      "type": "RockSoil",
      "label": "Rock and Soil",
      "params": {
        "rock_color": { "String": "706858" },
        "soil_color": { "String": "8B7040" },
        "slope_threshold": { "Float": 0.45 },
        "slope_blend": { "Float": 0.25 },
        "ao_strength": { "Float": 0.8 }
      }
    },
    {
      "key": "veg",
      "type": "Vegetation",
      "label": "Jungle",
      "params": {
        "vegetation_color": { "String": "2B6B15" },
        "dry_color": { "String": "7A6030" },
        "altitude_max": { "Float": 0.65 },
        "slope_cutoff": { "Float": 0.5 },
        "slope_blend": { "Float": 0.2 },
        "ao_strength": { "Float": 0.6 }
      }
    },
    {
      "key": "composite",
      "type": "TextureOverlay",
      "label": "Composite",
      "params": {
        "blend_mode": { "String": "over" },
        "opacity": { "Float": 1.0 }
      }
    }
  ],
  "connections": [
    { "from": "shape.output",     "to": "noise.control" },
    { "from": "noise.output",     "to": "sink.input" },
    { "from": "sink.output",      "to": "smooth.input" },
    { "from": "smooth.output",    "to": "slope_map.input" },
    { "from": "smooth.output",    "to": "rock_soil.input" },
    { "from": "slope_map.output", "to": "rock_soil.slope" },
    { "from": "smooth.output",    "to": "veg.input" },
    { "from": "slope_map.output", "to": "veg.slope" },
    { "from": "rock_soil.output", "to": "composite.base" },
    { "from": "veg.output",       "to": "composite.overlay" }
  ],
  "subgraph": {
    "label": "Archipelago - Dense",
    "color_idx": 3,
    "collapsed": true,
    "inputs": [],
    "outputs": [
      { "name": "terrain", "label": "Terrain", "kind": "Heightmap", "binding": "smooth:output" },
      { "name": "texture", "label": "Texture", "kind": "Color",     "binding": "composite:output" },
      { "name": "slope",   "label": "Slope",   "kind": "Heightmap", "binding": "slope_map:output" }
    ]
  },
  "macro_params": [
    { "name": "island_size",      "label": "Island size",      "kind": "Float", "binding": "noise:frequency",  "min": 3.0,  "max": 12.0 },
    { "name": "sea_level",        "label": "Sea level",        "kind": "Float", "binding": "sink:bias",        "min": 0.15, "max": 0.5  },
    { "name": "jungle_cover",     "label": "Jungle cover",     "kind": "Float", "binding": "veg:altitude_max", "min": 0.3,  "max": 0.9  },
    { "name": "seed",             "label": "Seed",             "kind": "UInt",  "binding": "noise:seed" }
  ]
}
