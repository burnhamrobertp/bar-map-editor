{
  "name": "Archipelago - Dense",
  "description": "Many small islands clustered together. Higher-frequency noise with radial shaping produces more peaks above sea level; less aggressive sinking keeps a larger fraction of the map as land.",
  "nodes": [
    {
      "key": "shape",
      "type": "Gradient",
      "label": "Island Envelope",
      "params": {
        "direction": { "String": "radial" },
        "invert": { "Bool": false },
        "center_x": { "Float": 0.5 },
        "center_y": { "Float": 0.5 }
      }
    },
    {
      "key": "noise",
      "type": "PerlinNoise",
      "label": "Island Noise",
      "params": {
        "character": { "String": "fine_detail" },
        "frequency": { "Float": 6.0 },
        "octaves": { "UInt": 6 },
        "lacunarity": { "Float": 2.0 },
        "persistence": { "Float": 0.5 },
        "seed": { "UInt": 19 }
      }
    },
    {
      "key": "sink",
      "type": "BiasGain",
      "label": "Sink Below Sea",
      "params": {
        "bias": { "Float": 0.35 },
        "gain": { "Float": 0.5 }
      }
    },
    {
      "key": "smooth",
      "type": "Blur",
      "label": "Soften Coastlines",
      "params": { "radius": { "Float": 0.8 } }
    },
    {
      "key": "slope_map",
      "type": "SlopeMap",
      "label": "Slope Map",
      "params": {}
    },
    {
      "key": "auto_tex",
      "type": "AutoTexture",
      "label": "Auto Texture",
      "params": { "biome": { "String": "tropical" } }
    }
  ],
  "connections": [
    { "from": "shape.output",  "to": "noise.control" },
    { "from": "noise.output",  "to": "sink.input" },
    { "from": "sink.output",   "to": "smooth.input" },
    { "from": "smooth.output", "to": "slope_map.input" },
    { "from": "smooth.output", "to": "auto_tex.input" },
    { "from": "slope_map.output", "to": "auto_tex.slope" }
  ],
  "subgraph": {
    "label": "Archipelago - Dense",
    "color_idx": 3,
    "collapsed": true,
    "inputs": [],
    "outputs": [
      { "name": "terrain", "label": "Terrain", "kind": "Heightmap", "binding": "smooth:output" },
      { "name": "texture", "label": "Texture", "kind": "Color",     "binding": "auto_tex:output" },
      { "name": "slope",   "label": "Slope",   "kind": "Heightmap", "binding": "slope_map:output" }
    ]
  },
  "macro_params": [
    { "name": "island_size",      "label": "Island size",      "kind": "Float", "binding": "noise:frequency", "min": 3.0,  "max": 12.0 },
    { "name": "sea_level",        "label": "Sea level",        "kind": "Float", "binding": "sink:bias",       "min": 0.15, "max": 0.5  },
    { "name": "coast_smoothness", "label": "Coast smoothness", "kind": "Float", "binding": "smooth:radius",   "min": 0.0,  "max": 3.0  },
    { "name": "seed",             "label": "Seed",             "kind": "UInt",  "binding": "noise:seed" }
  ]
}
