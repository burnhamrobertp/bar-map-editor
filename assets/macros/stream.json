{
  "name": "stream",
  "description": "Narrow stream / creek following a drawn course. Double-click the inner Layout node to redraw the course. Carve: blend onto base with mode subtract, using the mask.",
  "nodes": [
    {
      "key": "channel", "type": "Layout", "label": "Channel",
      "params": { "item_count": { "UInt": 1 }, "mode": { "String": "ridge" }, "type_0": { "String": "spline" },
        "points_0": { "Spline": [[0.22, 0.22], [0.38, 0.42], [0.55, 0.38], [0.7, 0.6], [0.8, 0.78]] },
        "closed_0": { "Bool": false }, "fill_0": { "Bool": false },
        "width_0": { "Float": 0.025 }, "height_0": { "Float": 0.3 }, "falloff_0": { "Float": 0.5 } }
    },
    { "key": "place", "type": "Transform", "label": "Placement", "params": { "translate_x": { "Float": 0.0 }, "translate_y": { "Float": 0.0 }, "scale": { "Float": 1.0 }, "angle": { "Float": 0.0 } } },
    { "key": "mask", "type": "MaskThreshold", "label": "Footprint", "params": { "threshold": { "Float": 0.03 }, "smoothness": { "Float": 0.1 } } }
  ],
  "connections": [
    { "from": "channel.output", "to": "place.input" },
    { "from": "place.output", "to": "mask.input" }
  ],
  "subgraph": {
    "outputs": [
      { "name": "terrain", "label": "Terrain", "kind": "Heightmap", "binding": "place:output" },
      { "name": "mask", "label": "Mask", "kind": "Mask", "binding": "mask:output" }
    ]
  },
  "macro_params": [
    { "name": "pos_x", "label": "Position X", "kind": "Float", "binding": "place:translate_x", "min": -0.5, "max": 0.5 },
    { "name": "pos_y", "label": "Position Y", "kind": "Float", "binding": "place:translate_y", "min": -0.5, "max": 0.5 },
    { "name": "rotation", "label": "Rotation", "kind": "Float", "binding": "place:angle", "min": 0.0, "max": 360.0 },
    { "name": "size", "label": "Size", "kind": "Float", "binding": "place:scale", "min": 0.4, "max": 2.0 },
    { "name": "width", "label": "Width", "kind": "Float", "binding": "channel:width_0", "min": 0.01, "max": 0.06 },
    { "name": "depth", "label": "Depth", "kind": "Float", "binding": "channel:height_0", "min": 0.1, "max": 0.5 }
  ]
}
