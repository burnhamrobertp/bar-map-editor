{
  "name": "Mountain Range - Foothills",
  "description": "Mountains fade to open ground across the map. A linear gradient fed into the noise control attenuates peaks toward one edge, so tall ridges on the right blend into flat foothills on the left.",
  "nodes": [
    {
      "key": "fall",
      "type": "Gradient",
      "label": "Fall-off",
      "params": {
        "direction": { "String": "linear_x" },
        "invert": { "Bool": false },
        "center_x": { "Float": 0.5 },
        "center_y": { "Float": 0.5 }
      }
    },
    {
      "key": "ridges",
      "type": "PerlinNoise",
      "label": "Mountain Noise",
      "params": {
        "character": { "String": "rugged" },
        "frequency": { "Float": 3.0 },
        "octaves": { "UInt": 6 },
        "lacunarity": { "Float": 2.2 },
        "persistence": { "Float": 0.65 },
        "seed": { "UInt": 71 }
      }
    },
    {
      "key": "erosion",
      "type": "ThermalErosion",
      "label": "Talus Erosion",
      "params": {
        "iterations": { "UInt": 80 },
        "talus_angle": { "Float": 0.22 }
      }
    },
    {
      "key": "smooth",
      "type": "Blur",
      "label": "Soften",
      "params": { "radius": { "Float": 1.0 } }
    },
    {
      "key": "slope_map",
      "type": "SlopeMap",
      "label": "Slope Map",
      "params": {}
    },
    {
      "key": "auto_tex",
      "type": "AutoTexture",
      "label": "Auto Texture",
      "params": { "biome": { "String": "mountainous" } }
    },
    {
      "key": "rock_soil",
      "type": "RockSoil",
      "label": "Rock and Soil",
      "params": {
        "rock_color": { "String": "706560" },
        "soil_color": { "String": "7A5C3A" },
        "slope_threshold": { "Float": 0.38 },
        "slope_blend": { "Float": 0.25 },
        "ao_strength": { "Float": 0.8 }
      }
    },
    {
      "key": "veg",
      "type": "Vegetation",
      "label": "Vegetation",
      "params": {
        "vegetation_color": { "String": "3B6B1A" },
        "dry_color": { "String": "6B5030" },
        "altitude_max": { "Float": 0.58 },
        "slope_cutoff": { "Float": 0.4 },
        "slope_blend": { "Float": 0.2 },
        "ao_strength": { "Float": 0.7 }
      }
    },
    {
      "key": "tex_blend",
      "type": "TextureWeightmap",
      "label": "Texture Blend",
      "params": {
        "layer_count": { "UInt": 3 },
        "priority_type": { "String": "priority" },
        "priority_0": { "Float": 0.0 },
        "exclusion_0": { "Float": 0.0 },
        "priority_1": { "Float": 2.0 },
        "exclusion_1": { "Float": 1.0 },
        "priority_2": { "Float": 1.0 },
        "exclusion_2": { "Float": 1.0 }
      }
    }
  ],
  "connections": [
    { "from": "fall.output",      "to": "ridges.control" },
    { "from": "ridges.output",    "to": "erosion.input" },
    { "from": "erosion.output",   "to": "smooth.input" },
    { "from": "smooth.output",    "to": "slope_map.input" },
    { "from": "smooth.output",    "to": "auto_tex.input" },
    { "from": "slope_map.output", "to": "auto_tex.slope" },
    { "from": "smooth.output",    "to": "rock_soil.input" },
    { "from": "slope_map.output", "to": "rock_soil.slope" },
    { "from": "smooth.output",    "to": "veg.input" },
    { "from": "slope_map.output", "to": "veg.slope" },
    { "from": "auto_tex.output",  "to": "tex_blend.texture_0" },
    { "from": "rock_soil.output", "to": "tex_blend.texture_1" },
    { "from": "veg.output",       "to": "tex_blend.texture_2" }
  ],
  "subgraph": {
    "label": "Mountain Range - Foothills",
    "color_idx": 2,
    "collapsed": true,
    "inputs": [],
    "outputs": [
      { "name": "terrain", "label": "Terrain", "kind": "Heightmap", "binding": "smooth:output" },
      { "name": "texture", "label": "Texture", "kind": "Color",     "binding": "tex_blend:output" },
      { "name": "slope",   "label": "Slope",   "kind": "Heightmap", "binding": "slope_map:output" }
    ]
  },
  "macro_params": [
    { "name": "ridge_density",  "label": "Ridge density",  "kind": "Float", "binding": "ridges:frequency",          "min": 1.0, "max": 6.0 },
    { "name": "erosion_passes", "label": "Erosion passes", "kind": "UInt",  "binding": "erosion:iterations",        "min": 0,   "max": 400 },
    { "name": "rock_threshold", "label": "Rock threshold", "kind": "Float", "binding": "rock_soil:slope_threshold", "min": 0.1, "max": 0.6 },
    { "name": "tree_line",      "label": "Tree line",      "kind": "Float", "binding": "veg:altitude_max",          "min": 0.2, "max": 0.8 },
    { "name": "seed",           "label": "Seed",           "kind": "UInt",  "binding": "ridges:seed" }
  ]
}
