{
  "name": "Mountain Range - Foothills",
  "description": "Mountains transitioning to lower terrain. The mountain pipeline (ridges + erosion) is multiplied by a horizontal gradient so peaks sit on one side and gentle foothills fade out toward the other. Wire its `terrain` output to a Bundler.",
  "nodes": [
    {
      "key": "ridges",
      "type": "PerlinNoise",
      "label": "Mountain Noise",
      "params": {
        "character": {
          "String": "rugged"
        },
        "frequency": {
          "Float": 3
        },
        "octaves": {
          "UInt": 6
        },
        "lacunarity": {
          "Float": 2.2
        },
        "persistence": {
          "Float": 0.65
        },
        "seed": {
          "UInt": 71
        }
      }
    },
    {
      "key": "erosion",
      "type": "ThermalErosion",
      "label": "Talus Erosion",
      "params": {
        "iterations": {
          "UInt": 80
        },
        "talus_angle": {
          "Float": 0.22
        }
      }
    },
    {
      "key": "fall",
      "type": "Gradient",
      "label": "Fall-off",
      "params": {
        "direction": {
          "String": "linear_x"
        },
        "invert": {
          "Bool": false
        },
        "center_x": {
          "Float": 0.35
        },
        "center_y": {
          "Float": 0.5
        }
      }
    },
    {
      "key": "shaped",
      "type": "Multiply",
      "label": "Apply Fall-off",
      "params": {}
    },
    {
      "key": "smooth",
      "type": "Blur",
      "label": "Soften",
      "params": {
        "radius": {
          "Float": 1
        }
      }
    },
    {
      "key": "slope_map",
      "type": "SlopeMap",
      "label": "Slope Map",
      "params": {}
    },
    {
      "key": "auto_tex",
      "type": "AutoTexture",
      "label": "Auto Texture",
      "params": {
        "biome": {
          "String": "mountainous"
        }
      }
    }
  ],
  "connections": [
    {
      "from": "ridges.output",
      "to": "erosion.input"
    },
    {
      "from": "erosion.output",
      "to": "shaped.a"
    },
    {
      "from": "fall.output",
      "to": "shaped.b"
    },
    {
      "from": "shaped.output",
      "to": "smooth.input"
    },
    {
      "from": "smooth.output",
      "to": "slope_map.input"
    },
    {
      "from": "smooth.output",
      "to": "auto_tex.input"
    },
    {
      "from": "slope_map.output",
      "to": "auto_tex.slope"
    }
  ],
  "subgraph": {
    "label": "Mountain Range - Foothills",
    "color_idx": 2,
    "collapsed": true,
    "inputs": [],
    "outputs": [
      {
        "name": "terrain",
        "label": "Terrain",
        "kind": "Heightmap",
        "binding": "smooth:output"
      },
      {
        "name": "texture",
        "label": "Texture",
        "kind": "Color",
        "binding": "auto_tex:output"
      },
      {
        "name": "slope",
        "label": "Slope",
        "kind": "Heightmap",
        "binding": "slope_map:output"
      }
    ]
  },
  "macro_params": [
    {
      "name": "ridge_density",
      "label": "Ridge density",
      "kind": "Float",
      "binding": "ridges:frequency",
      "min": 1,
      "max": 6
    },
    {
      "name": "foothill_extent",
      "label": "Foothill extent",
      "kind": "Float",
      "binding": "fall:center_x",
      "min": 0,
      "max": 1
    },
    {
      "name": "erosion_passes",
      "label": "Erosion passes",
      "kind": "UInt",
      "binding": "erosion:iterations",
      "min": 0,
      "max": 400
    },
    {
      "name": "smoothing",
      "label": "Smoothing",
      "kind": "Float",
      "binding": "smooth:radius",
      "min": 0,
      "max": 4
    },
    {
      "name": "seed",
      "label": "Seed",
      "kind": "UInt",
      "binding": "ridges:seed",
      "min": 0,
      "max": 100000
    }
  ]
