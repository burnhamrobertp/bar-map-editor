{
  "name": "Dunes - Sharp",
  "description": "Active sand sea with tightly-packed sharp-crested dunes. High frequency and minimal blur keeps ridge lines prominent. Suggests an actively blown desert where crests haven't yet rounded.",
  "nodes": [
    {
      "key": "noise",
      "type": "PerlinNoise",
      "label": "Dune Noise",
      "params": {
        "character": { "String": "fine_detail" },
        "frequency": { "Float": 6.0 },
        "octaves": { "UInt": 5 },
        "lacunarity": { "Float": 2.0 },
        "persistence": { "Float": 0.5 },
        "seed": { "UInt": 73 }
      }
    },
    {
      "key": "compress",
      "type": "BiasGain",
      "label": "Compress Amplitude",
      "params": {
        "bias": { "Float": 0.5 },
        "gain": { "Float": 0.4 }
      }
    },
    {
      "key": "smooth",
      "type": "Blur",
      "label": "Light Soften",
      "params": { "radius": { "Float": 0.7 } }
    },
    {
      "key": "slope_map",
      "type": "SlopeMap",
      "label": "Slope Map",
      "params": {}
    },
    {
      "key": "rock_soil",
      "type": "RockSoil",
      "label": "Sand and Rock",
      "params": {
        "soil_color": { "String": "D4AA64" },
        "rock_color": { "String": "A07850" },
        "slope_threshold": { "Float": 0.35 },
        "slope_blend": { "Float": 0.25 },
        "ao_strength": { "Float": 0.5 }
      }
    }
  ],
  "connections": [
    { "from": "noise.output",     "to": "compress.input" },
    { "from": "compress.output",  "to": "smooth.input" },
    { "from": "smooth.output",    "to": "slope_map.input" },
    { "from": "smooth.output",    "to": "rock_soil.input" },
    { "from": "slope_map.output", "to": "rock_soil.slope" }
  ],
  "subgraph": {
    "label": "Dunes - Sharp",
    "color_idx": 5,
    "collapsed": true,
    "inputs": [],
    "outputs": [
      { "name": "terrain", "label": "Terrain", "kind": "Heightmap", "binding": "smooth:output" },
      { "name": "texture", "label": "Texture", "kind": "Color",     "binding": "rock_soil:output" },
      { "name": "slope",   "label": "Slope",   "kind": "Heightmap", "binding": "slope_map:output" }
    ]
  },
  "macro_params": [
    { "name": "dune_size",   "label": "Dune size",   "kind": "Float",  "binding": "noise:frequency",  "min": 3.0, "max": 12.0 },
    { "name": "dune_height", "label": "Dune height", "kind": "Float",  "binding": "compress:gain",    "min": 0.1, "max": 0.7  },
    { "name": "sand_color",  "label": "Sand color",  "kind": "String", "binding": "rock_soil:soil_color" },
    { "name": "seed",        "label": "Seed",        "kind": "UInt",   "binding": "noise:seed" }
  ]
}
