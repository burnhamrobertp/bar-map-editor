    { "key": "floor", "type": "Constant", "label": "Floor", "params": { "value": { "Float": 0.3 } } },
    { "key": "grain", "type": "PerlinNoise", "label": "Faint grain", "params": { "character": { "String": "rolling_hills" }, "frequency": { "Float": 3.0 }, "seed": { "UInt": 1 } } },
    { "key": "terrain", "type": "Blend", "label": "Plain", "params": { "mode": { "String": "blend" }, "factor": { "Float": 0.06 } } }
  ],
  "connections": [
    { "from": "floor.output", "to": "terrain.a" },
    { "from": "grain.output", "to": "terrain.b" }
  ],
  "subgraph": {
    "outputs": [
      { "name": "terrain", "label": "Terrain", "kind": "Heightmap", "binding": "terrain:output" }
    ]
  },
  "macro_params": [
    { "name": "level", "label": "Ground level", "kind": "Float", "binding": "floor:value", "min": 0.0, "max": 0.6 },
    { "name": "grain", "label": "Grain", "kind": "Float", "binding": "terrain:factor", "min": 0.0, "max": 0.3 },
    { "name": "seed", "label": "Seed", "kind": "UInt", "binding": "grain:seed" }
  ]
}
