{
  "name": "basin",
  "description": "Broad shallow bowl / lowland depression. Carve: blend onto base with mode subtract, using the mask.",
  "nodes": [
    {
      "key": "bowl", "type": "Layout", "label": "Bowl",
      "params": { "item_count": { "UInt": 1 }, "mode": { "String": "ridge" }, "type_0": { "String": "ellipse" },
        "x_0": { "Float": 0.5 }, "y_0": { "Float": 0.5 }, "rx_0": { "Float": 0.32 }, "ry_0": { "Float": 0.28 }, "height_0": { "Float": 0.4 }, "falloff_0": { "Float": 0.7 } }
    },
    { "key": "place", "type": "Transform", "label": "Placement", "params": { "translate_x": { "Float": 0.0 }, "translate_y": { "Float": 0.0 }, "scale": { "Float": 1.0 }, "angle": { "Float": 0.0 } } },
    { "key": "mask", "type": "MaskThreshold", "label": "Footprint", "params": { "threshold": { "Float": 0.02 }, "smoothness": { "Float": 0.12 } } }
  ],
  "connections": [
    { "from": "bowl.output", "to": "place.input" },
    { "from": "place.output", "to": "mask.input" }
  ],
  "subgraph": {
    "outputs": [
      { "name": "terrain", "label": "Terrain", "kind": "Heightmap", "binding": "place:output" },
      { "name": "mask", "label": "Mask", "kind": "Mask", "binding": "mask:output" }
    ]
  },
  "macro_params": [
    { "name": "pos_x", "label": "Position X", "kind": "Float", "binding": "place:translate_x", "min": -0.5, "max": 0.5 },
    { "name": "pos_y", "label": "Position Y", "kind": "Float", "binding": "place:translate_y", "min": -0.5, "max": 0.5 },
    { "name": "size", "label": "Size", "kind": "Float", "binding": "place:scale", "min": 0.4, "max": 2.5 },
    { "name": "depth", "label": "Depth", "kind": "Float", "binding": "bowl:height_0", "min": 0.1, "max": 0.7 },
    { "name": "edge", "label": "Edge softness", "kind": "Float", "binding": "bowl:falloff_0", "min": 0.3, "max": 0.9 }
  ]
}
