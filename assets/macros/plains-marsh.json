{
  "name": "Plains - Marsh",
  "description": "Very flat, low-elevation terrain. Broad-wave noise is strongly compressed in amplitude then heavily blurred, leaving an almost-uniform surface where the slightest depression pools water.",
  "nodes": [
    {
      "key": "noise",
      "type": "PerlinNoise",
      "label": "Marsh Noise",
      "params": {
        "character": { "String": "broad_waves" },
        "frequency": { "Float": 1.5 },
        "octaves": { "UInt": 3 },
        "lacunarity": { "Float": 2.0 },
        "persistence": { "Float": 0.4 },
        "seed": { "UInt": 31 }
      }
    },
    {
      "key": "compress",
      "type": "BiasGain",
      "label": "Flatten",
      "params": {
        "bias": { "Float": 0.5 },
        "gain": { "Float": 0.15 }
      }
    },
    {
      "key": "smooth",
      "type": "Blur",
      "label": "Soften",
      "params": { "radius": { "Float": 3.0 } }
    },
    {
      "key": "slope_map",
      "type": "SlopeMap",
      "label": "Slope Map",
      "params": {}
    },
    {
      "key": "auto_tex",
      "type": "AutoTexture",
      "label": "Auto Texture",
      "params": { "biome": { "String": "tundra" } }
    },
    {
      "key": "rock_soil",
      "type": "RockSoil",
      "label": "Rock and Soil",
      "params": {
        "rock_color": { "String": "7A8070" },
        "soil_color": { "String": "4A5A38" },
        "slope_threshold": { "Float": 0.6 },
        "slope_blend": { "Float": 0.2 },
        "ao_strength": { "Float": 0.6 }
      }
    },
    {
      "key": "veg",
      "type": "Vegetation",
      "label": "Marsh Vegetation",
      "params": {
        "vegetation_color": { "String": "3A6030" },
        "dry_color": { "String": "6A5838" },
        "altitude_max": { "Float": 0.92 },
        "slope_cutoff": { "Float": 0.5 },
        "slope_blend": { "Float": 0.2 },
        "ao_strength": { "Float": 0.5 }
      }
    },
    {
      "key": "rock_comp",
      "type": "TextureOverlay",
      "label": "Rock Detail",
      "params": {
        "blend_mode": { "String": "over" },
        "opacity": { "Float": 1.0 }
      }
    },
    {
      "key": "veg_comp",
      "type": "TextureOverlay",
      "label": "Vegetation Detail",
      "params": {
        "blend_mode": { "String": "over" },
        "opacity": { "Float": 1.0 }
      }
    }
  ],
  "connections": [
    { "from": "noise.output",     "to": "compress.input" },
    { "from": "compress.output",  "to": "smooth.input" },
    { "from": "smooth.output",    "to": "slope_map.input" },
    { "from": "smooth.output",    "to": "auto_tex.input" },
    { "from": "slope_map.output", "to": "auto_tex.slope" },
    { "from": "smooth.output",    "to": "rock_soil.input" },
    { "from": "slope_map.output", "to": "rock_soil.slope" },
    { "from": "smooth.output",    "to": "veg.input" },
    { "from": "slope_map.output", "to": "veg.slope" },
    { "from": "auto_tex.output",  "to": "rock_comp.base" },
    { "from": "rock_soil.output", "to": "rock_comp.overlay" },
    { "from": "rock_comp.output", "to": "veg_comp.base" },
    { "from": "veg.output",       "to": "veg_comp.overlay" }
  ],
  "subgraph": {
    "label": "Plains - Marsh",
    "color_idx": 1,
    "collapsed": true,
    "inputs": [],
    "outputs": [
      { "name": "terrain", "label": "Terrain", "kind": "Heightmap", "binding": "smooth:output" },
      { "name": "texture", "label": "Texture", "kind": "Color",     "binding": "veg_comp:output" },
      { "name": "slope",   "label": "Slope",   "kind": "Heightmap", "binding": "slope_map:output" }
    ]
  },
  "macro_params": [
    { "name": "wetness",     "label": "Wetness",          "kind": "Float", "binding": "compress:gain",   "min": 0.05, "max": 0.5 },
    { "name": "noise_scale", "label": "Noise scale",      "kind": "Float", "binding": "noise:frequency", "min": 0.5,  "max": 4.0 },
    { "name": "tree_line",   "label": "Vegetation cap",   "kind": "Float", "binding": "veg:altitude_max","min": 0.5,  "max": 1.0 },
    { "name": "seed",        "label": "Seed",             "kind": "UInt",  "binding": "noise:seed" }
  ]
}
