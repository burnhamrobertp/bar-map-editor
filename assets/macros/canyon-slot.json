    {
      "key": "ridges",
      "type": "RidgedNoise",
      "label": "Slot Ridges",
      "params": {
        "frequency": {
          "Float": 4.5
        },
        "octaves": {
          "UInt": 6
        },
        "lacunarity": {
          "Float": 2.4
        },
        "seed": {
          "UInt": 53
        }
      }
    },
    {
      "key": "invert",
      "type": "Invert",
      "label": "Plateau ↔ Canyon",
      "params": {}
    },
    {
      "key": "lift",
      "type": "BiasGain",
      "label": "Lift Plateau",
      "params": {
        "bias": {
          "Float": 0.7
        },
        "gain": {
          "Float": 0.5
        }
      }
    },
    {
      "key": "smooth",
      "type": "Blur",
      "label": "Light Soften",
      "params": {
        "radius": {
          "Float": 0.3
        }
      }
