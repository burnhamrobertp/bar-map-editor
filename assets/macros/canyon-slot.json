{
  "name": "Canyon - Slot",
  "description": "Narrow deep cuts through a high plateau. High-frequency ridged noise produces tight slot canyons; very light blur preserves their sharpness.",
  "nodes": [
    {
      "key": "ridges",
      "type": "RidgedNoise",
      "label": "Slot Ridges",
      "params": {
        "character": { "String": "broken_terrain" },
        "frequency": { "Float": 4.5 },
        "octaves": { "UInt": 6 },
        "lacunarity": { "Float": 2.4 },
        "persistence": { "Float": 0.5 },
        "seed": { "UInt": 53 }
      }
    },
    {
      "key": "invert_terrain",
      "type": "Invert",
      "label": "Plateau / Canyon",
      "params": {}
    },
    {
      "key": "lift",
      "type": "BiasGain",
      "label": "Lift Plateau",
      "params": {
        "bias": { "Float": 0.70 },
        "gain": { "Float": 0.5 }
      }
    },
    {
      "key": "smooth",
      "type": "Blur",
      "label": "Light Soften",
      "params": { "radius": { "Float": 0.3 } }
    },
    {
      "key": "slope_map",
      "type": "SlopeMap",
      "label": "Slope Map",
      "params": {}
    },
    {
      "key": "auto_tex",
      "type": "AutoTexture",
      "label": "Auto Texture",
      "params": { "biome": { "String": "desert" } }
    },
    {
      "key": "rock_soil",
      "type": "RockSoil",
      "label": "Rock and Soil",
      "params": {
        "soil_color": { "String": "C07040" },
        "rock_color": { "String": "804020" },
        "slope_threshold": { "Float": 0.15 },
        "slope_blend": { "Float": 0.15 },
        "ao_strength": { "Float": 0.8 }
      }
    },
    {
      "key": "veg",
      "type": "Vegetation",
      "label": "Canyon Floor Scrub",
      "params": {
        "vegetation_color": { "String": "2A5010" },
        "dry_color": { "String": "704020" },
        "altitude_max": { "Float": 0.05 },
        "slope_cutoff": { "Float": 0.05 },
        "slope_blend": { "Float": 0.05 },
        "ao_strength": { "Float": 0.5 }
      }
    },
    {
      "key": "rock_comp",
      "type": "TextureOverlay",
      "label": "Rock Detail",
      "params": {
        "blend_mode": { "String": "over" },
        "opacity": { "Float": 1.0 }
      }
    },
    {
      "key": "veg_comp",
      "type": "TextureOverlay",
      "label": "Scrub Detail",
      "params": {
        "blend_mode": { "String": "over" },
        "opacity": { "Float": 1.0 }
      }
    }
  ],
  "connections": [
    { "from": "ridges.output",         "to": "invert_terrain.input" },
    { "from": "invert_terrain.output", "to": "lift.input" },
    { "from": "lift.output",           "to": "smooth.input" },
    { "from": "smooth.output",         "to": "slope_map.input" },
    { "from": "smooth.output",         "to": "auto_tex.input" },
    { "from": "slope_map.output",      "to": "auto_tex.slope" },
    { "from": "smooth.output",         "to": "rock_soil.input" },
    { "from": "slope_map.output",      "to": "rock_soil.slope" },
    { "from": "smooth.output",         "to": "veg.input" },
    { "from": "slope_map.output",      "to": "veg.slope" },
    { "from": "auto_tex.output",       "to": "rock_comp.base" },
    { "from": "rock_soil.output",      "to": "rock_comp.overlay" },
    { "from": "rock_comp.output",      "to": "veg_comp.base" },
    { "from": "veg.output",            "to": "veg_comp.overlay" }
  ],
  "subgraph": {
    "label": "Canyon - Slot",
    "color_idx": 4,
    "collapsed": true,
    "inputs": [],
    "outputs": [
      { "name": "terrain", "label": "Terrain", "kind": "Heightmap", "binding": "smooth:output" },
      { "name": "texture", "label": "Texture", "kind": "Color",     "binding": "veg_comp:output" },
      { "name": "slope",   "label": "Slope",   "kind": "Heightmap", "binding": "slope_map:output" }
    ]
  },
  "macro_params": [
    { "name": "slot_density",   "label": "Slot density",   "kind": "Float", "binding": "ridges:frequency", "min": 2.0, "max": 8.0 },
    { "name": "plateau_height", "label": "Plateau height", "kind": "Float", "binding": "lift:bias",        "min": 0.5, "max": 0.9 },
    { "name": "scrub_line",     "label": "Scrub line",     "kind": "Float", "binding": "veg:altitude_max", "min": 0.0, "max": 0.2 },
    { "name": "seed",           "label": "Seed",           "kind": "UInt",  "binding": "ridges:seed" }
  ]
}
