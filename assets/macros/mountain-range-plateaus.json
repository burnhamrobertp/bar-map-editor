{
  "name": "Mountain Range - Plateaus",
  "description": "Flat-topped peaks separated by steep drops. Rugged noise is eroded then hard-clamped, shearing off summits into level plateaus. Good for chokepoints and fortified high ground.",
  "nodes": [
    {
      "key": "shape",
      "type": "Gradient",
      "label": "Shape",
      "params": {
        "direction": { "String": "radial" },
        "invert": { "Bool": false },
        "center_x": { "Float": 0.5 },
        "center_y": { "Float": 0.5 }
      }
    },
    {
      "key": "ridges",
      "type": "PerlinNoise",
      "label": "Mountain Noise",
      "params": {
        "character": { "String": "rugged" },
        "frequency": { "Float": 3.0 },
        "octaves": { "UInt": 7 },
        "lacunarity": { "Float": 2.2 },
        "persistence": { "Float": 0.65 },
        "seed": { "UInt": 47 }
      }
    },
    {
      "key": "erosion",
      "type": "ThermalErosion",
      "label": "Talus Erosion",
      "params": {
        "iterations": { "UInt": 60 },
        "talus_angle": { "Float": 0.30 }
      }
    },
    {
      "key": "cap",
      "type": "Clamp",
      "label": "Plateau Cap",
      "params": {
        "min": { "Float": 0.0 },
        "max": { "Float": 0.62 }
      }
    },
    {
      "key": "smooth",
      "type": "Blur",
      "label": "Soften Edges",
      "params": { "radius": { "Float": 1.0 } }
    },
    {
      "key": "slope_map",
      "type": "SlopeMap",
      "label": "Slope Map",
      "params": {}
    },
    {
      "key": "auto_tex",
      "type": "AutoTexture",
      "label": "Auto Texture",
      "params": { "biome": { "String": "mountainous" } }
    }
  ],
  "connections": [
    { "from": "shape.output",   "to": "ridges.control" },
    { "from": "ridges.output",  "to": "erosion.input" },
    { "from": "erosion.output", "to": "cap.input" },
    { "from": "cap.output",     "to": "smooth.input" },
    { "from": "smooth.output",  "to": "slope_map.input" },
    { "from": "smooth.output",  "to": "auto_tex.input" },
    { "from": "slope_map.output", "to": "auto_tex.slope" }
  ],
  "subgraph": {
    "label": "Mountain Range - Plateaus",
    "color_idx": 2,
    "collapsed": true,
    "inputs": [],
    "outputs": [
      { "name": "terrain", "label": "Terrain", "kind": "Heightmap", "binding": "smooth:output" },
      { "name": "texture", "label": "Texture", "kind": "Color",     "binding": "auto_tex:output" },
      { "name": "slope",   "label": "Slope",   "kind": "Heightmap", "binding": "slope_map:output" }
    ]
  },
  "macro_params": [
    { "name": "ridge_density",  "label": "Ridge density",   "kind": "Float", "binding": "ridges:frequency",   "min": 1.0, "max": 6.0 },
    { "name": "plateau_height", "label": "Plateau height",  "kind": "Float", "binding": "cap:max",            "min": 0.3, "max": 0.95 },
    { "name": "erosion_passes", "label": "Erosion passes",  "kind": "UInt",  "binding": "erosion:iterations", "min": 0,   "max": 200 },
    { "name": "smoothing",      "label": "Smoothing",       "kind": "Float", "binding": "smooth:radius",      "min": 0.0, "max": 4.0 },
    { "name": "seed",           "label": "Seed",            "kind": "UInt",  "binding": "ridges:seed" }
  ]
}
