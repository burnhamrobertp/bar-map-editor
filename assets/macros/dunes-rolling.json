{
  "name": "Dunes - Rolling",
  "description": "Broad gentle dune swells. Low frequency and heavy blur produce wide rises rather than sharp crests -- suggesting ancient, wind-rounded dunes or a desert plain seen from altitude.",
  "nodes": [
    {
      "key": "noise",
      "type": "PerlinNoise",
      "label": "Dune Noise",
      "params": {
        "character": { "String": "broad_waves" },
        "frequency": { "Float": 1.8 },
        "octaves": { "UInt": 3 },
        "lacunarity": { "Float": 2.0 },
        "persistence": { "Float": 0.4 },
        "seed": { "UInt": 67 }
      }
    },
    {
      "key": "compress",
      "type": "BiasGain",
      "label": "Compress Amplitude",
      "params": {
        "bias": { "Float": 0.5 },
        "gain": { "Float": 0.4 }
      }
    },
    {
      "key": "smooth",
      "type": "Blur",
      "label": "Soften Crests",
      "params": { "radius": { "Float": 3.5 } }
    },
    {
      "key": "slope_map",
      "type": "SlopeMap",
      "label": "Slope Map",
      "params": {}
    },
    {
      "key": "auto_tex",
      "type": "AutoTexture",
      "label": "Auto Texture",
      "params": { "biome": { "String": "desert" } }
    },
    {
      "key": "rock_soil",
      "type": "RockSoil",
      "label": "Sand and Rock",
      "params": {
        "soil_color": { "String": "D4AA64" },
        "rock_color": { "String": "A07850" },
        "slope_threshold": { "Float": 0.4 },
        "slope_blend": { "Float": 0.3 },
        "ao_strength": { "Float": 0.35 }
      }
    },
    {
      "key": "tex_blend",
      "type": "TextureWeightmap",
      "label": "Texture Blend",
      "params": {
        "layer_count": { "UInt": 2 },
        "priority_type": { "String": "priority" },
        "priority_0": { "Float": 0.0 },
        "exclusion_0": { "Float": 0.0 },
        "priority_1": { "Float": 1.0 },
        "exclusion_1": { "Float": 1.0 }
      }
    }
  ],
  "connections": [
    { "from": "noise.output",     "to": "compress.input" },
    { "from": "compress.output",  "to": "smooth.input" },
    { "from": "smooth.output",    "to": "slope_map.input" },
    { "from": "smooth.output",    "to": "auto_tex.input" },
    { "from": "slope_map.output", "to": "auto_tex.slope" },
    { "from": "smooth.output",    "to": "rock_soil.input" },
    { "from": "slope_map.output", "to": "rock_soil.slope" },
    { "from": "auto_tex.output",  "to": "tex_blend.texture_0" },
    { "from": "rock_soil.output", "to": "tex_blend.texture_1" }
  ],
  "subgraph": {
    "label": "Dunes - Rolling",
    "color_idx": 5,
    "collapsed": true,
    "inputs": [],
    "outputs": [
      { "name": "terrain", "label": "Terrain", "kind": "Heightmap", "binding": "smooth:output" },
      { "name": "texture", "label": "Texture", "kind": "Color",     "binding": "tex_blend:output" },
      { "name": "slope",   "label": "Slope",   "kind": "Heightmap", "binding": "slope_map:output" }
    ]
  },
  "macro_params": [
    { "name": "dune_size",   "label": "Dune size",   "kind": "Float",  "binding": "noise:frequency",  "min": 0.8, "max": 4.0 },
    { "name": "dune_height", "label": "Dune height", "kind": "Float",  "binding": "compress:gain",    "min": 0.1, "max": 0.7 },
    { "name": "sand_color",  "label": "Sand color",  "kind": "String", "binding": "rock_soil:soil_color" },
    { "name": "seed",        "label": "Seed",        "kind": "UInt",   "binding": "noise:seed" }
  ]
}
