{
  "name": "Plains - With Hills",
  "description": "Open plains with organically-clustered hills. A Voronoi cell mask selects where the hill layer dominates, so rises appear in natural patches rather than as a uniform blend.",
  "nodes": [
    {
      "key": "base",
      "type": "PerlinNoise",
      "label": "Plains Base",
      "params": {
        "character": { "String": "broad_waves" },
        "frequency": { "Float": 1.2 },
        "octaves": { "UInt": 3 },
        "lacunarity": { "Float": 2.0 },
        "persistence": { "Float": 0.4 },
        "seed": { "UInt": 23 }
      }
    },
    {
      "key": "hills",
      "type": "PerlinNoise",
      "label": "Hill Layer",
      "params": {
        "character": { "String": "rolling_hills" },
        "frequency": { "Float": 4.5 },
        "octaves": { "UInt": 5 },
        "lacunarity": { "Float": 2.0 },
        "persistence": { "Float": 0.55 },
        "seed": { "UInt": 91 }
      }
    },
    {
      "key": "cells",
      "type": "Voronoi",
      "label": "Hill Patches",
      "params": {
        "frequency": { "Float": 2.8 },
        "mode": { "String": "cell" },
        "seed": { "UInt": 37 }
      }
    },
    {
      "key": "thresh",
      "type": "MaskThreshold",
      "label": "Patch Threshold",
      "params": {
        "threshold": { "Float": 0.52 },
        "smoothness": { "Float": 0.18 }
      }
    },
    {
      "key": "chooser",
      "type": "Chooser",
      "label": "Pick Hills",
      "params": {}
    },
    {
      "key": "smooth",
      "type": "Blur",
      "label": "Soften",
      "params": { "radius": { "Float": 1.5 } }
    },
    {
      "key": "slope_map",
      "type": "SlopeMap",
      "label": "Slope Map",
      "params": {}
    },
    {
      "key": "auto_tex",
      "type": "AutoTexture",
      "label": "Auto Texture",
      "params": { "biome": { "String": "temperate" } }
    },
    {
      "key": "rock_soil",
      "type": "RockSoil",
      "label": "Rock and Soil",
      "params": {
        "rock_color": { "String": "909080" },
        "soil_color": { "String": "8B7850" },
        "slope_threshold": { "Float": 0.5 },
        "slope_blend": { "Float": 0.25 },
        "ao_strength": { "Float": 0.7 }
      }
    },
    {
      "key": "veg",
      "type": "Vegetation",
      "label": "Vegetation",
      "params": {
        "vegetation_color": { "String": "4A7A20" },
        "dry_color": { "String": "8A7040" },
        "altitude_max": { "Float": 0.75 },
        "slope_cutoff": { "Float": 0.55 },
        "slope_blend": { "Float": 0.2 },
        "ao_strength": { "Float": 0.6 }
      }
    },
    {
      "key": "rock_comp",
      "type": "TextureOverlay",
      "label": "Rock Detail",
      "params": {
        "blend_mode": { "String": "over" },
        "opacity": { "Float": 1.0 }
      }
    },
    {
      "key": "veg_comp",
      "type": "TextureOverlay",
      "label": "Vegetation Detail",
      "params": {
        "blend_mode": { "String": "over" },
        "opacity": { "Float": 1.0 }
      }
    }
  ],
  "connections": [
    { "from": "base.output",      "to": "chooser.a" },
    { "from": "hills.output",     "to": "chooser.b" },
    { "from": "cells.output",     "to": "thresh.input" },
    { "from": "thresh.output",    "to": "chooser.mask" },
    { "from": "chooser.output",   "to": "smooth.input" },
    { "from": "smooth.output",    "to": "slope_map.input" },
    { "from": "smooth.output",    "to": "auto_tex.input" },
    { "from": "slope_map.output", "to": "auto_tex.slope" },
    { "from": "smooth.output",    "to": "rock_soil.input" },
    { "from": "slope_map.output", "to": "rock_soil.slope" },
    { "from": "smooth.output",    "to": "veg.input" },
    { "from": "slope_map.output", "to": "veg.slope" },
    { "from": "auto_tex.output",  "to": "rock_comp.base" },
    { "from": "rock_soil.output", "to": "rock_comp.overlay" },
    { "from": "rock_comp.output", "to": "veg_comp.base" },
    { "from": "veg.output",       "to": "veg_comp.overlay" }
  ],
  "subgraph": {
    "label": "Plains - With Hills",
    "color_idx": 1,
    "collapsed": true,
    "inputs": [],
    "outputs": [
      { "name": "terrain", "label": "Terrain", "kind": "Heightmap", "binding": "smooth:output" },
      { "name": "texture", "label": "Texture", "kind": "Color",     "binding": "veg_comp:output" },
      { "name": "slope",   "label": "Slope",   "kind": "Heightmap", "binding": "slope_map:output" }
    ]
  },
  "macro_params": [
    { "name": "hill_coverage",  "label": "Hill coverage",  "kind": "Float", "binding": "thresh:threshold",          "min": 0.3, "max": 0.75 },
    { "name": "hill_size",      "label": "Hill size",      "kind": "Float", "binding": "hills:frequency",           "min": 1.5, "max": 8.0  },
    { "name": "rock_threshold", "label": "Rock threshold", "kind": "Float", "binding": "rock_soil:slope_threshold", "min": 0.3, "max": 0.8  },
    { "name": "tree_line",      "label": "Tree line",      "kind": "Float", "binding": "veg:altitude_max",          "min": 0.4, "max": 1.0  },
    { "name": "seed",           "label": "Seed",           "kind": "UInt",  "binding": "base:seed" }
  ]
}
