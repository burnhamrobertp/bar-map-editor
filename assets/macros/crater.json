{
  "name": "crater",
  "description": "Crater with a raised rim and sunken floor around a mid baseline. Absolute: combine with MaskApply (base into background, this into input, mask into mask).",
  "nodes": [
    { "key": "base", "type": "Constant", "label": "Baseline", "params": { "value": { "Float": 0.4 } } },
    {
      "key": "rim_big", "type": "Layout", "label": "Outer cone",
      "params": { "item_count": { "UInt": 1 }, "mode": { "String": "ridge" }, "type_0": { "String": "ellipse" }, "x_0": { "Float": 0.5 }, "y_0": { "Float": 0.5 }, "rx_0": { "Float": 0.2 }, "ry_0": { "Float": 0.2 }, "height_0": { "Float": 0.35 }, "falloff_0": { "Float": 0.55 } }
    },
    {
      "key": "rim_small", "type": "Layout", "label": "Inner cone",
      "params": { "item_count": { "UInt": 1 }, "mode": { "String": "ridge" }, "type_0": { "String": "ellipse" }, "x_0": { "Float": 0.5 }, "y_0": { "Float": 0.5 }, "rx_0": { "Float": 0.13 }, "ry_0": { "Float": 0.13 }, "height_0": { "Float": 0.35 }, "falloff_0": { "Float": 0.55 } }
    },
    { "key": "ring", "type": "Subtract", "label": "Rim ring" },
    {
      "key": "pit", "type": "Layout", "label": "Pit",
      "params": { "item_count": { "UInt": 1 }, "mode": { "String": "ridge" }, "type_0": { "String": "ellipse" }, "x_0": { "Float": 0.5 }, "y_0": { "Float": 0.5 }, "rx_0": { "Float": 0.11 }, "ry_0": { "Float": 0.11 }, "height_0": { "Float": 0.28 }, "falloff_0": { "Float": 0.4 } }
    },
    { "key": "with_rim", "type": "Add", "label": "Base + rim" },
    { "key": "carved", "type": "Subtract", "label": "Carve floor" },
    { "key": "place", "type": "Transform", "label": "Placement", "params": { "translate_x": { "Float": 0.0 }, "translate_y": { "Float": 0.0 }, "scale": { "Float": 1.0 }, "angle": { "Float": 0.0 } } },
    { "key": "diff", "type": "Equation", "label": "Deviation", "params": { "formula": { "String": "abs(a-0.4)" } } },
    { "key": "mask", "type": "MaskThreshold", "label": "Footprint", "params": { "threshold": { "Float": 0.02 }, "smoothness": { "Float": 0.15 } } }
  ],
  "connections": [
    { "from": "rim_big.output", "to": "ring.a" },
    { "from": "rim_small.output", "to": "ring.b" },
    { "from": "base.output", "to": "with_rim.a" },
    { "from": "ring.output", "to": "with_rim.b" },
    { "from": "with_rim.output", "to": "carved.a" },
    { "from": "pit.output", "to": "carved.b" },
    { "from": "carved.output", "to": "place.input" },
    { "from": "place.output", "to": "diff.a" },
    { "from": "diff.output", "to": "mask.input" }
  ],
  "subgraph": {
    "outputs": [
      { "name": "terrain", "label": "Terrain", "kind": "Heightmap", "binding": "place:output" },
      { "name": "mask", "label": "Mask", "kind": "Mask", "binding": "mask:output" }
    ]
  },
  "macro_params": [
    { "name": "pos_x", "label": "Position X", "kind": "Float", "binding": "place:translate_x", "min": -0.5, "max": 0.5 },
    { "name": "pos_y", "label": "Position Y", "kind": "Float", "binding": "place:translate_y", "min": -0.5, "max": 0.5 },
    { "name": "size", "label": "Size", "kind": "Float", "binding": "place:scale", "min": 0.4, "max": 2.0 },
    { "name": "rim", "label": "Rim height", "kind": "Float", "binding": "rim_big:height_0", "min": 0.1, "max": 0.6 },
    { "name": "depth", "label": "Floor depth", "kind": "Float", "binding": "pit:height_0", "min": 0.1, "max": 0.5 }
  ]
}
