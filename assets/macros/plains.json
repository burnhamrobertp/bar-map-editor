{
  "name": "Plains",
  "description": "Gently rolling open terrain. A radial gradient subtly concentrates undulation toward the center, leaving flatter approach corridors on the flanks. Good for cavalry-friendly maps.",
  "nodes": [
    {
      "key": "shape",
      "type": "Gradient",
      "label": "Shape",
      "params": {
        "direction": { "String": "radial" },
        "invert": { "Bool": false },
        "center_x": { "Float": 0.5 },
        "center_y": { "Float": 0.5 }
      }
    },
    {
      "key": "rolling",
      "type": "PerlinNoise",
      "label": "Rolling",
      "params": {
        "character": { "String": "rolling_hills" },
        "frequency": { "Float": 2.0 },
        "octaves": { "UInt": 4 },
        "lacunarity": { "Float": 2.0 },
        "persistence": { "Float": 0.45 },
        "seed": { "UInt": 7 }
      }
    },
    {
      "key": "smooth",
      "type": "Blur",
      "label": "Soften",
      "params": { "radius": { "Float": 2.0 } }
    },
    {
      "key": "slope_map",
      "type": "SlopeMap",
      "label": "Slope Map",
      "params": {}
    },
    {
      "key": "auto_tex",
      "type": "AutoTexture",
      "label": "Auto Texture",
      "params": { "biome": { "String": "temperate" } }
    }
  ],
  "connections": [
    { "from": "shape.output",   "to": "rolling.control" },
    { "from": "rolling.output", "to": "smooth.input" },
    { "from": "smooth.output",  "to": "slope_map.input" },
    { "from": "smooth.output",  "to": "auto_tex.input" },
    { "from": "slope_map.output", "to": "auto_tex.slope" }
  ],
  "subgraph": {
    "label": "Plains",
    "color_idx": 1,
    "collapsed": true,
    "inputs": [],
    "outputs": [
      { "name": "terrain", "label": "Terrain", "kind": "Heightmap", "binding": "smooth:output" },
      { "name": "texture", "label": "Texture", "kind": "Color",     "binding": "auto_tex:output" },
      { "name": "slope",   "label": "Slope",   "kind": "Heightmap", "binding": "slope_map:output" }
    ]
  },
  "macro_params": [
    { "name": "rolling_amount", "label": "Rolling amount", "kind": "Float", "binding": "rolling:frequency", "min": 0.5, "max": 4.0 },
    { "name": "smoothing",      "label": "Smoothing",      "kind": "Float", "binding": "smooth:radius",     "min": 0.0, "max": 6.0 },
    { "name": "seed",           "label": "Seed",           "kind": "UInt",  "binding": "rolling:seed" }
  ]
}
