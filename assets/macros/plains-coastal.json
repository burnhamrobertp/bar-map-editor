{
  "name": "Plains - Coastal",
  "description": "Terrain rises from sea level on the left edge to full plains on the right. A linear gradient used as noise control naturally attenuates height toward the shoreline rather than hard-multiplying, producing a gentler coastal slope.",
  "nodes": [
    {
      "key": "shore",
      "type": "Gradient",
      "label": "Shore Gradient",
      "params": {
        "direction": { "String": "linear_x" },
        "invert": { "Bool": false },
        "center_x": { "Float": 0.5 },
        "center_y": { "Float": 0.5 }
      }
    },
    {
      "key": "noise",
      "type": "PerlinNoise",
      "label": "Plains Noise",
      "params": {
        "character": { "String": "rolling_hills" },
        "frequency": { "Float": 2.5 },
        "octaves": { "UInt": 5 },
        "lacunarity": { "Float": 2.0 },
        "persistence": { "Float": 0.45 },
        "seed": { "UInt": 17 }
      }
    },
    {
      "key": "smooth",
      "type": "Blur",
      "label": "Soften",
      "params": { "radius": { "Float": 1.5 } }
    },
    {
      "key": "slope_map",
      "type": "SlopeMap",
      "label": "Slope Map",
      "params": {}
    },
    {
      "key": "auto_tex",
      "type": "AutoTexture",
      "label": "Auto Texture",
      "params": { "biome": { "String": "temperate" } }
    },
    {
      "key": "rock_soil",
      "type": "RockSoil",
      "label": "Rock and Soil",
      "params": {
        "rock_color": { "String": "908070" },
        "soil_color": { "String": "8B7B50" },
        "slope_threshold": { "Float": 0.55 },
        "slope_blend": { "Float": 0.25 },
        "ao_strength": { "Float": 0.7 }
      }
    },
    {
      "key": "veg",
      "type": "Vegetation",
      "label": "Vegetation",
      "params": {
        "vegetation_color": { "String": "4A7A20" },
        "dry_color": { "String": "8A7040" },
        "altitude_max": { "Float": 0.80 },
        "slope_cutoff": { "Float": 0.6 },
        "slope_blend": { "Float": 0.2 },
        "ao_strength": { "Float": 0.6 }
      }
    },
    {
      "key": "rock_comp",
      "type": "TextureOverlay",
      "label": "Rock Detail",
      "params": {
        "blend_mode": { "String": "over" },
        "opacity": { "Float": 1.0 }
      }
    },
    {
      "key": "veg_comp",
      "type": "TextureOverlay",
      "label": "Vegetation Detail",
      "params": {
        "blend_mode": { "String": "over" },
        "opacity": { "Float": 1.0 }
      }
    }
  ],
  "connections": [
    { "from": "shore.output",     "to": "noise.control" },
    { "from": "noise.output",     "to": "smooth.input" },
    { "from": "smooth.output",    "to": "slope_map.input" },
    { "from": "smooth.output",    "to": "auto_tex.input" },
    { "from": "slope_map.output", "to": "auto_tex.slope" },
    { "from": "smooth.output",    "to": "rock_soil.input" },
    { "from": "slope_map.output", "to": "rock_soil.slope" },
    { "from": "smooth.output",    "to": "veg.input" },
    { "from": "slope_map.output", "to": "veg.slope" },
    { "from": "auto_tex.output",  "to": "rock_comp.base" },
    { "from": "rock_soil.output", "to": "rock_comp.overlay" },
    { "from": "rock_comp.output", "to": "veg_comp.base" },
    { "from": "veg.output",       "to": "veg_comp.overlay" }
  ],
  "subgraph": {
    "label": "Plains - Coastal",
    "color_idx": 1,
    "collapsed": true,
    "inputs": [],
    "outputs": [
      { "name": "terrain", "label": "Terrain", "kind": "Heightmap", "binding": "smooth:output" },
      { "name": "texture", "label": "Texture", "kind": "Color",     "binding": "veg_comp:output" },
      { "name": "slope",   "label": "Slope",   "kind": "Heightmap", "binding": "slope_map:output" }
    ]
  },
  "macro_params": [
    { "name": "rolling_amount", "label": "Rolling amount", "kind": "Float", "binding": "noise:frequency",           "min": 0.5, "max": 4.0 },
    { "name": "rock_threshold", "label": "Rock threshold", "kind": "Float", "binding": "rock_soil:slope_threshold", "min": 0.3, "max": 0.8 },
    { "name": "tree_line",      "label": "Tree line",      "kind": "Float", "binding": "veg:altitude_max",          "min": 0.4, "max": 1.0 },
    { "name": "seed",           "label": "Seed",           "kind": "UInt",  "binding": "noise:seed" }
  ]
}
