{
  "name": "island",
  "description": "A landmass rising from the sea, with a drawn coastline. Double-click the inner Layout node to redraw the outline. Absolute: combine with MaskApply (base into background, this into input, mask into mask).",
  "nodes": [
    {
      "key": "core", "type": "Layout", "label": "Landmass",
      "params": { "item_count": { "UInt": 1 }, "mode": { "String": "ridge" }, "type_0": { "String": "spline" },
        "points_0": { "Spline": [[0.36, 0.3], [0.66, 0.33], [0.74, 0.55], [0.6, 0.74], [0.36, 0.7], [0.28, 0.48]] },
        "closed_0": { "Bool": true }, "fill_0": { "Bool": true },
        "width_0": { "Float": 0.05 }, "height_0": { "Float": 1.0 }, "falloff_0": { "Float": 0.7 } }
    },
    { "key": "place", "type": "Transform", "label": "Placement", "params": { "translate_x": { "Float": 0.0 }, "translate_y": { "Float": 0.0 }, "scale": { "Float": 1.0 }, "angle": { "Float": 0.0 } } },
    { "key": "coastnoise", "type": "RidgedNoise", "label": "Coast", "params": { "character": { "String": "broad_ridges" }, "frequency": { "Float": 2.5 }, "octaves": { "UInt": 4 }, "seed": { "UInt": 9 } } },
    { "key": "coastmod", "type": "Blend", "label": "Irregular coast", "params": { "mode": { "String": "blend" }, "factor": { "Float": 0.18 } } },
    { "key": "hconst", "type": "Constant", "label": "Land height", "params": { "value": { "Float": 0.62 } } },
    { "key": "terrain", "type": "Multiply", "label": "Island" },
    { "key": "mask", "type": "MaskThreshold", "label": "Footprint", "params": { "threshold": { "Float": 0.04 }, "smoothness": { "Float": 0.12 } } }
  ],
  "connections": [
    { "from": "core.output", "to": "place.input" },
    { "from": "place.output", "to": "coastmod.a" },
    { "from": "coastnoise.output", "to": "coastmod.b" },
    { "from": "coastmod.output", "to": "terrain.a" },
    { "from": "hconst.output", "to": "terrain.b" },
    { "from": "place.output", "to": "mask.input" }
  ],
  "subgraph": {
    "outputs": [
      { "name": "terrain", "label": "Terrain", "kind": "Heightmap", "binding": "terrain:output" },
      { "name": "mask", "label": "Mask", "kind": "Mask", "binding": "mask:output" }
    ]
  },
  "macro_params": [
    { "name": "pos_x", "label": "Position X", "kind": "Float", "binding": "place:translate_x", "min": -0.5, "max": 0.5 },
    { "name": "pos_y", "label": "Position Y", "kind": "Float", "binding": "place:translate_y", "min": -0.5, "max": 0.5 },
    { "name": "size", "label": "Size", "kind": "Float", "binding": "place:scale", "min": 0.4, "max": 2.0 },
    { "name": "height", "label": "Height", "kind": "Float", "binding": "hconst:value", "min": 0.3, "max": 0.9 },
    { "name": "shore", "label": "Shore gradient", "kind": "Float", "binding": "core:falloff_0", "min": 0.4, "max": 0.9 },
    { "name": "coast", "label": "Coast irregularity", "kind": "Float", "binding": "coastmod:factor", "min": 0.0, "max": 0.4 }
  ]
}
