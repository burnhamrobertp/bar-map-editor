{
  "name": "Archipelago - Sparse",
  "description": "A few large islands separated by wide sea lanes. Low-frequency noise with radial envelope keeps peaks broad; aggressive sinking submerges most of the map, leaving only the highest ground exposed.",
  "nodes": [
    {
      "key": "shape",
      "type": "Gradient",
      "label": "Island Envelope",
      "params": {
        "direction": { "String": "radial" },
        "invert": { "Bool": false },
        "center_x": { "Float": 0.5 },
        "center_y": { "Float": 0.5 }
      }
    },
    {
      "key": "noise",
      "type": "PerlinNoise",
      "label": "Island Noise",
      "params": {
        "character": { "String": "broad_waves" },
        "frequency": { "Float": 1.5 },
        "octaves": { "UInt": 4 },
        "lacunarity": { "Float": 2.0 },
        "persistence": { "Float": 0.45 },
        "seed": { "UInt": 7 }
      }
    },
    {
      "key": "sink",
      "type": "BiasGain",
      "label": "Sink Below Sea",
      "params": {
        "bias": { "Float": 0.18 },
        "gain": { "Float": 0.55 }
      }
    },
    {
      "key": "smooth",
      "type": "Blur",
      "label": "Soften Coastlines",
      "params": { "radius": { "Float": 2.0 } }
    },
    {
      "key": "slope_map",
      "type": "SlopeMap",
      "label": "Slope Map",
      "params": {}
    },
    {
      "key": "auto_tex",
      "type": "AutoTexture",
      "label": "Auto Texture",
      "params": { "biome": { "String": "tropical" } }
    },
    {
      "key": "rock_soil",
      "type": "RockSoil",
      "label": "Rock and Soil",
      "params": {
        "rock_color": { "String": "706858" },
        "soil_color": { "String": "8B7040" },
        "slope_threshold": { "Float": 0.35 },
        "slope_blend": { "Float": 0.3 },
        "ao_strength": { "Float": 0.8 }
      }
    },
    {
      "key": "veg",
      "type": "Vegetation",
      "label": "Jungle",
      "params": {
        "vegetation_color": { "String": "2B6B15" },
        "dry_color": { "String": "7A6030" },
        "altitude_max": { "Float": 0.75 },
        "slope_cutoff": { "Float": 0.5 },
        "slope_blend": { "Float": 0.2 },
        "ao_strength": { "Float": 0.6 }
      }
    },
    {
      "key": "tex_blend",
      "type": "TextureWeightmap",
      "label": "Texture Blend",
      "params": {
        "layer_count": { "UInt": 3 },
        "priority_type": { "String": "priority" },
        "priority_0": { "Float": 0.0 },
        "exclusion_0": { "Float": 0.0 },
        "priority_1": { "Float": 2.0 },
        "exclusion_1": { "Float": 1.0 },
        "priority_2": { "Float": 1.0 },
        "exclusion_2": { "Float": 1.0 }
      }
    }
  ],
  "connections": [
    { "from": "shape.output",     "to": "noise.control" },
    { "from": "noise.output",     "to": "sink.input" },
    { "from": "sink.output",      "to": "smooth.input" },
    { "from": "smooth.output",    "to": "slope_map.input" },
    { "from": "smooth.output",    "to": "auto_tex.input" },
    { "from": "slope_map.output", "to": "auto_tex.slope" },
    { "from": "smooth.output",    "to": "rock_soil.input" },
    { "from": "slope_map.output", "to": "rock_soil.slope" },
    { "from": "smooth.output",    "to": "veg.input" },
    { "from": "slope_map.output", "to": "veg.slope" },
    { "from": "auto_tex.output",  "to": "tex_blend.texture_0" },
    { "from": "rock_soil.output", "to": "tex_blend.texture_1" },
    { "from": "veg.output",       "to": "tex_blend.texture_2" }
  ],
  "subgraph": {
    "label": "Archipelago - Sparse",
    "color_idx": 3,
    "collapsed": true,
    "inputs": [],
    "outputs": [
      { "name": "terrain", "label": "Terrain", "kind": "Heightmap", "binding": "smooth:output" },
      { "name": "texture", "label": "Texture", "kind": "Color",     "binding": "tex_blend:output" },
      { "name": "slope",   "label": "Slope",   "kind": "Heightmap", "binding": "slope_map:output" }
    ]
  },
  "macro_params": [
    { "name": "island_size",  "label": "Island size",  "kind": "Float", "binding": "noise:frequency",  "min": 0.5, "max": 3.0 },
    { "name": "sea_level",    "label": "Sea level",    "kind": "Float", "binding": "sink:bias",        "min": 0.05,"max": 0.4  },
    { "name": "jungle_cover", "label": "Jungle cover", "kind": "Float", "binding": "veg:altitude_max", "min": 0.3, "max": 0.9  },
    { "name": "seed",         "label": "Seed",         "kind": "UInt",  "binding": "noise:seed" }
  ]
}
