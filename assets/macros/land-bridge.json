{
  "name": "land-bridge",
  "description": "A narrow isthmus / land bridge connecting two areas across water. Additive: blend onto base with mode add, using the mask (raises a passable strip above sea level).",
  "nodes": [
    {
      "key": "strip", "type": "Layout", "label": "Isthmus",
      "params": { "item_count": { "UInt": 1 }, "mode": { "String": "ridge" }, "type_0": { "String": "rectangle" }, "x_0": { "Float": 0.5 }, "y_0": { "Float": 0.5 }, "rx_0": { "Float": 0.45 }, "ry_0": { "Float": 0.08 }, "height_0": { "Float": 0.6 }, "falloff_0": { "Float": 0.6 } }
    },
    { "key": "place", "type": "Transform", "label": "Placement", "params": { "translate_x": { "Float": 0.0 }, "translate_y": { "Float": 0.0 }, "scale": { "Float": 1.0 }, "angle": { "Float": 0.0 } } },
    { "key": "mask", "type": "MaskThreshold", "label": "Footprint", "params": { "threshold": { "Float": 0.04 }, "smoothness": { "Float": 0.1 } } }
  ],
  "connections": [
    { "from": "strip.output", "to": "place.input" },
    { "from": "place.output", "to": "mask.input" }
  ],
  "subgraph": {
    "outputs": [
      { "name": "terrain", "label": "Terrain", "kind": "Heightmap", "binding": "place:output" },
      { "name": "mask", "label": "Mask", "kind": "Mask", "binding": "mask:output" }
    ]
  },
  "macro_params": [
    { "name": "pos_x", "label": "Position X", "kind": "Float", "binding": "place:translate_x", "min": -0.5, "max": 0.5 },
    { "name": "pos_y", "label": "Position Y", "kind": "Float", "binding": "place:translate_y", "min": -0.5, "max": 0.5 },
    { "name": "rotation", "label": "Rotation", "kind": "Float", "binding": "place:angle", "min": 0.0, "max": 360.0 },
    { "name": "length", "label": "Length", "kind": "Float", "binding": "strip:rx_0", "min": 0.2, "max": 0.5 },
    { "name": "width", "label": "Width", "kind": "Float", "binding": "strip:ry_0", "min": 0.03, "max": 0.18 },
    { "name": "height", "label": "Height", "kind": "Float", "binding": "strip:height_0", "min": 0.2, "max": 0.9 }
  ]
}
