        },
        "mode": {
          "String": "valley"
        },
        "amplitude": {
          "Float": 0.4
        }
      }
    },
    {
      "key": "carve",
      "type": "Multiply",
      "label": "Multiply (carve)",
      "params": {}
    },
    {
      "key": "output",
      "type": "FinalComposition",
      "label": "Export",
      "params": {}
    }
  ],
  "connections": [
